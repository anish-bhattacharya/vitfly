Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /DepthImage1
        - /Grid1
        - /QuadState1
      Splitter Ratio: 0.618852436542511
    Tree Height: 140
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Image

Displays:
  - Class: rviz/Grid
    Name: Grid
    Plane Cell Count: 10

  - Class: rviz/Image
    Image Topic: /kingfisher/dodgeros_pilot/unity/depth_viz
    Name: DepthImage
    Transport Hint: raw
    Value: true

  - Class: rviz/Odometry
    Name: QuadState
    Topic: /kingfisher/state
    Shape:
      Value: Axes

  - Class: rviz/Marker
    Name: ModelVelocity
    Marker Topic: /debug/vel_marker
    Value: true

View:
  Target Frame: <Fixed Frame>
  Class: rviz/Orbit
  Distance: 10
  Pitch: 0.5
  Yaw: 0.5
